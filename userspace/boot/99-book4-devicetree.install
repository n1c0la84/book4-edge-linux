#!/bin/bash
# Samsung Galaxy Book4 Edge 14": keep a devicetree line in every BLS entry, a
# copy of the DTB in /boot/dtb-<kver>/, and regenerate the static ESP grub.cfg
# so it always names kernels that exist. Runs after 90-loaderentry.install.
#
# Dry run (no root needed, prints grub.cfg):  BOOK4_DRYRUN=1 <this> add <kver>
COMMAND=$1
KVER=$2

DTB=x1e80100-samsung-galaxy-book4-edge-14.dtb
SRC=/usr/lib/firmware/book4/$DTB
BOOT=${BOOK4_BOOT:-/boot}   # override only for dry-run tests
ESPCFG=/boot/efi/EFI/fedora/grub.cfg

if [ "$COMMAND" = add ] && [ -r "$SRC" ] && [ -z "$BOOK4_DRYRUN" ]; then
    install -d -m 755 "/boot/dtb-$KVER"
    install -m 644 "$SRC" "/boot/dtb-$KVER/$DTB"

    for e in /boot/loader/entries/*"$KVER"*.conf; do
        [ -e "$e" ] || continue
        lin=$(sed -n 's/^linux[[:space:]]\+//p' "$e" | head -1)
        [ -n "$lin" ] || continue
        prefix=${lin%vmlinuz-*}
        grep -q '^devicetree[[:space:]]' "$e" && continue
        printf 'devicetree %sdtb-%s/%s\n' "$prefix" "$KVER" "$DTB" >> "$e"
    done
fi

# --- ESP grub.cfg ------------------------------------------------------------
case "$COMMAND" in add|remove) ;; *) exit 0 ;; esac

# Bootable = vmlinuz + initramfs + DTB all present. On remove, drop $KVER even
# if its files are still on disk at this point.
kernels=()
while read -r k; do
    [ "$COMMAND" = remove ] && [ "$k" = "$KVER" ] && continue
    [ -e "$BOOT/initramfs-$k.img" ] && [ -e "$BOOT/dtb-$k/$DTB" ] || continue
    kernels+=("$k")
done < <(ls $BOOT/vmlinuz-* 2>/dev/null | sed "s|^$BOOT/vmlinuz-||" | grep -v rescue | sort -rV)

if [ ${#kernels[@]} -eq 0 ]; then
    echo "book4: no complete kernel in /boot, leaving $ESPCFG untouched" >&2
    exit 0
fi

CMDLINE=$(cat /etc/kernel/cmdline)

# Default = the pinned known-good kernel if it is still bootable, else the
# newest. New kernels appear below it until you test one from the menu and
# re-pin:  echo <kver> > /etc/book4/default-kernel  and re-run this hook.
PIN=$(cat "${BOOK4_PINFILE:-/etc/book4/default-kernel}" 2>/dev/null)
for i in "${!kernels[@]}"; do
    if [ "${kernels[$i]}" = "$PIN" ]; then
        kernels=("$PIN" "${kernels[@]:0:$i}" "${kernels[@]:$((i+1))}")
        break
    fi
done
default=${kernels[0]}
TESTDTB=$(cat "${BOOK4_TESTFILE:-/etc/book4/test-dtb}" 2>/dev/null)

entry() {  # $1=kver $2=title suffix $3=extra args [$4=DTB path in /boot]
    cat <<EOF

menuentry "Fedora Linux ($1) - $2" {
    devicetree (\$bootdev)${4:-/dtb-$1/$DTB}
    linux  (\$bootdev)/vmlinuz-$1 $CMDLINE$3
    initrd (\$bootdev)/initramfs-$1.img
}
EOF
}

gen() {
    cat <<EOF
# Samsung Galaxy Book4 Edge 14" - regenerated by 99-book4-devicetree.install
# on every kernel add/remove. Hand edits here are lost; edit the hook instead.
set timeout=5
set timeout_style=menu
set gfxpayload=keep

# /boot is a separate ext4 partition; find it by a file only it has
search --no-floppy --set=bootdev --file /vmlinuz-$default

# Snapdragon X firmware memory-map workaround. Removing this causes instant
# reboots on this machine. Refused under Secure Boot lockdown.
if [ "\$lockdown" != "y" ]; then
  cutmem 0x8800000000 0x8fffffffff
fi
EOF
    entry "$default" "Book4 Edge" ""
    entry "$default" "verbose" " earlycon keep_bootcon ignore_loglevel"
    # Optional experimental device tree: /etc/book4/test-dtb names a DTB under /boot
    # (e.g. /dtb-test/ec-events.dtb). Never the default; delete the file to drop the entry.
    if [ -n "$TESTDTB" ] && [ -e "$BOOT$TESTDTB" ]; then
        entry "$default" "alt DT ${TESTDTB##*/}" "" "$TESTDTB"
    fi
    for k in "${kernels[@]:1}"; do
        entry "$k" "Book4 Edge (other)" ""
    done
    # Windows shares the ESP; chainload its boot manager when it is there.
    if [ -e /boot/efi/EFI/Microsoft/Boot/bootmgfw.efi ] || [ -n "$BOOK4_WINDOWS" ]; then
        cat <<EOF

menuentry "Windows Boot Manager" {
    search --no-floppy --set=winesp --file /EFI/Microsoft/Boot/bootmgfw.efi
    chainloader (\$winesp)/EFI/Microsoft/Boot/bootmgfw.efi
}
EOF
    fi
    printf '\nmenuentry "UEFI Firmware Settings" { fwsetup }\n'
}

if [ -n "$BOOK4_DRYRUN" ]; then
    gen
    exit 0
fi

# Write next to the target and rename, so a crash never leaves half a file.
# Keep the previous version as grub.cfg.prev (ours; the ESP is otherwise add-only).
tmp=$ESPCFG.new
gen > "$tmp" && grep -q "vmlinuz-$default" "$tmp" && grep -q cutmem "$tmp" || {
    echo "book4: generated grub.cfg failed checks, leaving $ESPCFG untouched" >&2
    rm -f "$tmp"; exit 0
}
[ -e "$ESPCFG" ] && cp -p "$ESPCFG" "$ESPCFG.prev"
mv "$tmp" "$ESPCFG"
sync -f "$ESPCFG"
echo "book4: $ESPCFG now boots $default (${#kernels[@]} kernel(s) listed)"
exit 0
