# libfprint from libfprint MR !547 "Implement SDCP v2 (including egismoc
# implementation)", unmerged upstream: the EgisTec 1c7a:05a1 (Galaxy Book4
# Edge, Book4 Pro) keeps enrolled prints only over SDCP.
# Shaped after Arch's libfprint PKGBUILD; the same approach for the Book4 Pro
# on x86_64: https://github.com/lanlanndn/galaxybook4-fingerprint
# Built by install/arch/sync-fingerprint.sh.

pkgname=libfprint-sdcp
_commit=2d7c5277de08c6b29b3fac7447f17a516fbc4d1c
pkgver=1.94.100.r547.g2d7c5277
pkgrel=1
pkgdesc="Library for fingerprint readers (libfprint MR !547: SDCP v2, egismoc)"
url="https://gitlab.freedesktop.org/libfprint/libfprint/-/merge_requests/547"
arch=(aarch64 x86_64)
license=(LGPL-2.1-or-later)
depends=(glib2 glibc libgcc libgudev libgusb openssl pixman)
makedepends=(git glib2-devel gobject-introspection gtk-doc meson python-cairo python-gobject systemd)
provides=("libfprint=1.94.100" libfprint-2.so)
conflicts=(libfprint)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#commit=$_commit")
b2sums=('SKIP')

build() {
  arch-meson libfprint build -D drivers=all -D installed-tests=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
