#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Book4 (install/arch/battery-policy.sh): low-battery warnings after Omarchy's
# shell, which warns once at 10 %: a second one at 8 % and a last one at 5 %.
# UPower powers off at 3 % (/etc/UPower/UPower.conf.d/70-book4.conf). Under
# heavy load the EC's reading is not to be trusted below 10 %: on 30 October,
# with every core busy, it went from 8 % to 0 % in six seconds and the
# machine died, so the 8 % warning is the one that matters. Each warning
# once per discharge: the flags are cleared when the battery is no longer
# discharging.
set -u
bat=/sys/class/power_supply/samsung-galaxybook-battery
flag=${XDG_RUNTIME_DIR:-/tmp}/book4-battery-warned
levels=${BOOK4_BATTERY_WARN:-8 5}
[ -r "$bat/capacity" ] || exit 0
cap=$(cat "$bat/capacity"); st=$(cat "$bat/status")
if [ "$st" != Discharging ]; then rm -f "$flag" "$flag".*; exit 0; fi
# The lowest level reached; skipping straight past 8 % gives only the last one.
hit=
for l in $levels; do [ "$cap" -le "$l" ] && hit=$l; done
[ -n "$hit" ] && [ ! -e "$flag.$hit" ] || exit 0
for l in $levels; do [ "$l" -ge "$hit" ] && touch "$flag.$l"; done
if [ "$hit" = "${levels##* }" ]; then
    body="Plug in now: the machine powers off at 3%."
else
    body="Plug in soon: under heavy load the battery can run out from here without further warning."
fi
omarchy-notification-send -g 󰂃 -u critical "Battery at ${cap}%" "$body" -i battery-empty -t 0
