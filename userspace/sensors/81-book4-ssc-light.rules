# Ambient light sensor behind the ADSP (Qualcomm SSC), read by iio-sensor-proxy
# through libssc (docs/sensors.md). EL1 and EL2 (tested at both, 25 Nov 2026).
ACTION=="remove", GOTO="book4_ssc_end"
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-light", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iio-sensor-proxy.service"
LABEL="book4_ssc_end"
