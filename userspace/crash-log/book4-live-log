#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Plain-text copy of this boot's journal, synced every 2 s, for hard resets.
# journald rewrites its files in place (nodatacow); after the 29 October
# reset the next boot found system.journal damaged and replaced it, losing
# 22 h. An appended text file loses at most its last couple of seconds.
# One file per boot in /var/log/book4-live/<boot id>.log, newest 10 kept.
set -u
dir=/var/log/book4-live
boot=$(tr -d - < /proc/sys/kernel/random/boot_id)
log=$dir/$boot.log
mkdir -p "$dir"
ls -1t "$dir"/*.log 2>/dev/null | tail -n +11 | xargs -r rm -f
find "$dir" -name '*.cursor' ! -name "$boot.cursor" -delete
[ -e "$dir/$boot.cursor" ] || {
    echo "== boot $boot, kernel $(uname -r), started $(date -Is)"
    echo "== cmdline $(cat /proc/cmdline)"
} >> "$log"

# fsync on a clean file costs nothing, so a fixed tick is cheap.
(while sleep 2; do sync "$log"; done) &
syncer=$!
trap 'kill $syncer 2>/dev/null; sync "$log"' EXIT

# Monotonic time: the wall clock jumps at boot (2024 RTC, then NTP).
# The cursor lets a restarted service go on without repeating the boot.
journalctl -b -f -n all -o short-monotonic --no-pager \
    --cursor-file="$dir/$boot.cursor" >> "$log"
