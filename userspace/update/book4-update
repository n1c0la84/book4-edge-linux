#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# book4-update: Arch Linux ARM + Omarchy 4.5 updater with pre-update btrfs
# snapshots of the running root subvolume (e.g. arch-45). Steps:
#   1. show what is pending (pacman, AUR, mise, flea) and ask
#   2. prune the pacman cache to 2 versions (before the snapshot, which would
#      otherwise pin what it deletes)
#   3. read-only snapshot of the running subvolume with
#      tools/backup/snapshot-arch.sh (top level of the root btrfs,
#      <subvol>-pre-update-<date>); keeps the newest 2 *-pre-update-* by
#      timestamp, never deletes any other snapshot
#   4. runs `omarchy-update` (keyring refresh, PID 1 scope-shielded upgrade,
#      migrations, shell update clear, service restarts, post-update Book4
#      verification hook, mise, AUR, reboot prompt); if `[omarchy]` shadows a
#      newer `extra/hyprland` needed for `extra/hyprgraphics`, upgrades it
#      cleanly first via `omarchy-update-pacman -Syu extra/hyprland`.
#      Use `--direct` to bypass `omarchy-update` and run pacman/yay/mise directly.
#   5. after: Book4 verification hook checks packages, libfprint-sdcp,
#      linux-modules-cleanup mask, book4-el2 status, Limine UKIs, Hyprland
#      config, and .pacnew files
#
# Usage:  book4-update           snapshot + omarchy-update (asks before changing anything)
#         book4-update --check   only show what is pending, no root needed
#         book4-update --no-snapshot
#         book4-update --direct  bypass omarchy-update (raw pacman -Syu, yay, mise)
#
# Rollback from a snapshot (from a live medium or TTY as root):
#   mount -o subvolid=5 UUID=<root uuid> /mnt
#   mv /mnt/<subvol> /mnt/<subvol>.broken
#   btrfs subvolume snapshot /mnt/<subvol>-pre-update-<date> /mnt/<subvol>
#   reboot; once fine: btrfs subvolume delete /mnt/<subvol>.broken
# Rollback of single packages: pacman -U /var/cache/pacman/pkg/<old>.pkg.tar.*
set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
VERIFY="$REPO/userspace/update/book4-post-update-check"
KEEP_SNAPSHOTS=2
MIN_FREE_GB=5
check=0 snapshot=1 direct=0
for a in "$@"; do
    case $a in
        --check) check=1 ;;
        --no-snapshot) snapshot=0 ;;
        --direct) direct=1 ;;
        -h|--help) sed -n '3,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $a (see --help)" >&2; exit 2 ;;
    esac
done

[ -e /etc/arch-release ] || { echo "Run this on Arch." >&2; exit 1; }
((EUID != 0)) || { echo "Run as your user (sudo is used inside; yay and mise need your home)." >&2; exit 1; }

say() { printf '\n\e[1;32m== %s\e[0m\n' "$*"; }
warn() { printf '\e[33m%s\e[0m\n' "$*" >&2; }

flea_latest() {
    pacman -Q flea &>/dev/null || return 0
    local have new
    have=$(pacman -Q flea | awk '{print $2}' | sed 's/-[0-9]*$//')
    new=$(curl -fsS --max-time 10 https://api.github.com/repos/thisisgm/flea/releases/latest 2>/dev/null |
        jq -r '.tag_name // empty' | sed 's/^v//') || true
    if [[ -n $new && $new != "$have" ]]; then
        echo "flea $have -> $new  (local build: bash install/arch/flea.sh $new)"
    fi
}

show_pending() {
    local rc=0
    say "Pending: repositories"
    checkupdates || rc=$?
    if ((rc == 2)); then
        echo "(none)"
    elif ((rc != 0)); then
        warn "checkupdates failed (exit $rc)"
    fi
    say "Pending: AUR"
    yay -Qua 2>/dev/null || echo "(none)"
    say "Pending: mise"
    mise outdated 2>/dev/null | grep . || echo "(none)"
    local f
    f=$(flea_latest)
    if [[ -n $f ]]; then say "Pending: local builds"; echo "$f"; fi
}

show_pending
((check == 0)) || exit 0

free_gb=$(df --output=avail -BG / | tail -1 | tr -dc 0-9)
((free_gb >= MIN_FREE_GB)) || { echo "Only ${free_gb} GB free on /; need ${MIN_FREE_GB} GB." >&2; exit 1; }

echo
read -r -p "Update now? [y/N] " ans
[[ $ans == [yY]* ]] || exit 0

say "Prune package cache (keep 2 versions)"
sudo paccache -rk2 || warn "Could not prune the package cache."

if ((snapshot)); then
    say "Snapshot of the arch subvolume"
    bash "$REPO/tools/backup/snapshot-arch.sh" pre-update
    # Keep the newest KEEP_SNAPSHOTS arch*-pre-update-* (arch-45-pre-update-* now); other snapshots
    # (arch-pre-omarchy-*, hand-made labels) are never touched.
    top=$(sudo mktemp -d /run/book4-update.XXXXXX)
    cleanup() { sudo umount "$top" 2>/dev/null || true; sudo rmdir "$top" 2>/dev/null || true; }
    trap cleanup EXIT
    sudo mount -o subvolid=5 "UUID=$(findmnt -no UUID /)" "$top"
    mapfile -t old < <(sudo find "$top" -mindepth 1 -maxdepth 1 -name 'arch*-pre-update-*' -printf '%f\n' |
        awk '{ t=$0; sub(/^.*-pre-update-/, "", t); print t "\t" $0 }' |
        sort | cut -f2- | head -n -"$KEEP_SNAPSHOTS")
    for o in "${old[@]}"; do
        sudo btrfs subvolume delete "$top/$o"
    done
    cleanup; trap - EXIT
fi

before=$(pacman -Q)
pacnew_before=$({ find /etc -name '*.pacnew' 2>/dev/null || true; } | sort)

# If [omarchy] (above [extra] in pacman.conf) pins an older hyprland than the
# extra/hyprland already installed or needed for extra/hyprgraphics, plain
# `pacman -Syu` fails on libhyprgraphics.so. Upgrade with `extra/hyprland`
# explicitly first so `omarchy-update` completes cleanly.
maybe_unblock_extra_hyprland() {
    pacman -Q hyprland &>/dev/null || return 0
    local loc om_ver
    loc=$(pacman -Q hyprland | awk '{print $2}')
    om_ver=$(pacman -Si omarchy/hyprland 2>/dev/null | awk -F': ' '/^Version/{print $2; exit}')
    [[ -n $om_ver ]] || return 0
    if (( $(vercmp "$loc" "$om_ver") > 0 )); then
        say "Syncing system with extra/hyprland (local $loc is ahead of [omarchy] $om_ver)"
        if command -v omarchy-update-pacman >/dev/null; then
            omarchy-update-pacman -Syu --needed --overwrite '/usr/share/omarchy/*' extra/hyprland
        else
            sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --needed extra/hyprland
        fi
    fi
}

if (( direct == 0 )) && command -v omarchy-update >/dev/null; then
    maybe_unblock_extra_hyprland
    say "Omarchy update"
    OMARCHY_UPDATE_UNATTENDED=0 omarchy-update -y
    # Run the Book4 check if not installed as an Omarchy post-update hook yet.
    if [[ -x $VERIFY && ! -e $HOME/.config/omarchy/hooks/post-update.d/90-book4-verify.sh ]]; then
        "$VERIFY" || true
    fi
    f=$(flea_latest)
    [[ -z $f ]] || echo "$f"
    exit 0
fi

say "System packages"
maybe_unblock_extra_hyprland
sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu

if pacman -Qqm | grep -q .; then
    say "AUR packages"
    yay -Sua || warn "AUR update failed; the system update above stands."
fi

if command -v mise >/dev/null; then
    say "mise tools"
    MISE_MINIMUM_RELEASE_AGE=0 mise up || warn "mise update failed."
fi

say "After the update"
changed=$(diff <(echo "$before") <(pacman -Q) | grep -c '^>' || true)
echo "$changed package(s) installed or changed."

if [[ -x $VERIFY ]]; then
    "$VERIFY" || true
fi

if command -v Hyprland >/dev/null; then
    exe=$(readlink "/proc/$(pgrep -x Hyprland | head -1)/exe" 2>/dev/null || true)
    if [[ $exe == *"(deleted)"* ]]; then
        warn "Hyprland was updated: log out and back in, then check hyprctl configerrors and the lock screen."
    fi
fi

new_pacnew=$(comm -13 <(echo "$pacnew_before") <({ find /etc -name '*.pacnew' 2>/dev/null || true; } | sort) | grep . || true)
[[ -z $new_pacnew ]] || { warn "New .pacnew files to merge:"; echo "$new_pacnew"; }

orphans=$(pacman -Qtdq 2>/dev/null || true)
[[ -z $orphans ]] || echo "Orphans (not removed; meson and sassc build Omarchy): $(echo $orphans)"

if command -v omarchy-migrate >/dev/null; then
    pending=$(omarchy-migrate --pending 2>/dev/null | grep . || true)
    [[ -z $pending ]] || { warn "Omarchy migrations pending (review before running omarchy-migrate):"; echo "$pending"; }
fi

f=$(flea_latest)
[[ -z $f ]] || echo "$f"
echo "Done."
