#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# systemd-sleep hook: measure every sleep, so normal use gives the drain
# figures the dedicated drain tests did (install/arch/sleep-log.sh).
#   pre:   time, battery charge, aosd/cxsd/ddr residency counters -> /run
#   post:  time and counters; a transient timer runs "report" 60 s later,
#          when the EC's battery reading has caught up with the wake-up
#   report: one journal line (journalctl -t book4-sleep) and a CSV row in
#          /var/log/book4-sleep.csv: minutes asleep, mAh, W, residency, and
#          the boot (el1, el2-sleep, or a variant of tools/power/el2-dt-test.sh:
#          el2-mods, el2-nomisc, el2-omshape, el2-nocl5) and the radios' rfkill state
# After sleeps of 30 min or more on battery, also a desktop notification
# (time asleep, W, days a full battery would last, deep-sleep share).
# Sleeps with the charger plugged in at either end are logged without a
# wattage. The minute awake before the reading is taken off with the
# battery's current at that moment (since 23 October).
set -u
bat=/sys/class/power_supply/samsung-galaxybook-battery
st=/sys/kernel/debug/qcom_stats
run=/run/book4-sleep
csv=/var/log/book4-sleep.csv
self=$(readlink -f "$0")

acc() {   # accumulated 19.2 MHz ticks in aosd cxsd ddr (0 if unreadable)
    local s v
    for s in aosd cxsd ddr; do
        v=$(awk -F: '/Accumulated Duration/{gsub(/ /,"",$2); print $2}' "$st/$s" 2>/dev/null)
        printf '%s ' "${v:-0}"
    done
}
cxinfo() {  # cxsd entries, apss entries, cxsd "Last Entered At" in ticks (0 if unreadable)
    local c a l
    c=$(awk -F: '/^Count/{gsub(/ /,"",$2); print $2}' "$st/cxsd" 2>/dev/null)
    a=$(awk -F: '/^Count/{gsub(/ /,"",$2); print $2}' "$st/apss" 2>/dev/null)
    l=$(awk -F: '/Last Entered At/{gsub(/ /,"",$2); print $2}' "$st/cxsd" 2>/dev/null)
    printf '%s %s %s' "${c:-0}" "${a:-0}" "${l:-0}"
}
boot() {  # which entry: el1, el2-sleep (daily) or a tools/power/el2-dt-test.sh variant
    local r
    grep -q 'id_aa64mmfr0.ecv=1' /proc/cmdline || { echo el1; return; }
    [ -e /sys/firmware/devicetree/base/regulator-misc-3p3/regulator-always-on ] || { echo el2-nomisc; return; }
    # CL4 only in the clusters (4 bytes = one phandle): omshape without a system state, nocl5 with
    if [ "$(stat -c %s /sys/firmware/devicetree/base/psci/power-domain-cpu-cluster0/domain-idle-states 2>/dev/null)" = 4 ]; then
        [ -e /sys/firmware/devicetree/base/psci/power-domain-system/domain-idle-states ] && echo el2-nocl5 || echo el2-omshape
        return
    fi
    r=$(od -A n -t u4 --endian=big /sys/firmware/devicetree/base/soc@0/pinctrl@f100000/gpio-reserved-ranges 2>/dev/null | tr -s ' ')
    case "$r" in *" 44 4"*) echo el2-sleep ;; *" 45 3"*) echo el2-mods ;; *) echo el2 ;; esac
}
radios() {  # e.g. "wlan:on bluetooth:off", from rfkill at suspend time
    rfkill -n -o TYPE,SOFT 2>/dev/null | awk '{ printf "%s%s:%s", (n++ ? " " : ""), $1, ($2 == "blocked" ? "off" : "on") }'
}
batt() { echo "$(cat "$bat/charge_now" 2>/dev/null || echo 0) $(cat "$bat/voltage_now" 2>/dev/null || echo 0) $(cat "$bat/status" 2>/dev/null || echo Unknown)"; }

notify() {  # HEADLINE BODY: an Omarchy notification in every logged-in user's session
    local u
    for u in $(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 {print $2}'); do
        systemd-run --quiet --user -M "$u@" --collect \
            /usr/share/omarchy/bin/omarchy-notification-send -g 󰒲 -u low "$1" "$2" -t 15000 >/dev/null 2>&1 || true
    done
}

case "${1:-}/${2:-}" in
pre/*)
    mkdir -p "$run"
    echo "$(date +%s) $(batt) $(acc)$(cxinfo)" > "$run/pre"
    radios > "$run/radios"
    rm -f "$run/post"
    ;;
post/*)
    [ -e "$run/pre" ] || exit 0
    echo "$(date +%s) $(batt) $(acc)$(cxinfo)" > "$run/post"
    systemd-run --quiet --on-active=60 --unit="book4-sleep-report-$(date +%s)" "$self" report >/dev/null 2>&1 || true
    ;;
report/*)
    [ -e "$run/pre" ] && [ -e "$run/post" ] || exit 0
    read -r t0 c0 v0 s0 a0 x0 d0 xc0 ac0 xl0 < "$run/pre"
    read -r t1 c1x v1x s1 a1 x1 d1 xc1 ac1 xl1 < "$run/post"
    xc0=${xc0:-0}; ac0=${ac0:-0}; xc1=${xc1:-0}; ac1=${ac1:-0}; xl1=${xl1:-0}
    read -r c1 v1 s2 <<<"$(batt)"
    rad=$(cat "$run/radios" 2>/dev/null || true)
    rm -f "$run/pre" "$run/post" "$run/radios"
    secs=$((t1 - t0)); [ "$secs" -gt 0 ] || exit 0
    # The charge is read ~60 s after the wake: take off what that awake
    # minute used (the battery's own current now, times the time awake), in
    # mAh, so short sleeps are comparable with long ones.
    awake=$(( $(date +%s) - t1 ))
    i_now=$(cat "$bat/current_now" 2>/dev/null || echo 0); i_now=${i_now#-}
    c1=$(( c1 + i_now * awake / 3600 ))
    res=$(awk -v s=$secs -v a=$((a1 - a0)) -v x=$((x1 - x0)) -v d=$((d1 - d0)) \
        'BEGIN { t = s * 19200000; printf "aosd %.1f%% cxsd %.1f%% ddr %.1f%%", 100*a/t, 100*x/t, 100*d/t }')
    if [ "$s0" = Discharging ] && [ "$s1" = Discharging ] && [ "$s2" = Discharging ]; then
        line=$(awk -v s=$secs -v c=$((c0 - c1)) -v v="$v0" -v r="$res" -v b="$(boot)" -v rad="$rad" \
            'BEGIN { wh = c / 1e6 * v / 1e6; printf "[%s] slept %.0f min on battery: %.0f mAh = %.2f Wh = %.2f W; %s; radios %s", b, s/60, c/1000, wh, wh / (s/3600), r, rad }')
        w=$(awk -v s=$secs -v c=$((c0 - c1)) -v v="$v0" 'BEGIN { printf "%.3f", c / 1e6 * v / 1e6 / (s/3600) }')
    else
        line="[$(boot)] slept $((secs / 60)) min, charger involved ($s0 -> $s1 -> $s2): no wattage; $res"
        w=
    fi
    # How often CX went down in this sleep (once = never disturbed) against
    # APSS, and when it last did, in the AOP's time since power-on: the
    # chip is woken below Linux at each full hour of that clock (14 November).
    if [ "$xc1" -gt "$xc0" ]; then
        line="$line$(awk -v n=$((xc1 - xc0)) -v p=$((ac1 - ac0)) -v l="$xl1" 'BEGIN { s = l / 19200000
            printf "; CX entries %d (APSS %d), last at +%dh %02dm %02ds of the AOP clock", n, p, int(s/3600), int((s%3600)/60), int(s%60) }')"
    fi
    logger -t book4-sleep "$line"
    # A desktop notification when the figure means something: on battery
    # throughout and at least 30 minutes asleep.
    if [ -n "$w" ] && [ "$secs" -ge 1800 ]; then
        full=$(cat "$bat/charge_full" 2>/dev/null || echo 0)
        msg=$(awk -v s=$secs -v c=$((c0 - c1)) -v v="$v0" -v w="$w" -v f="$full" -v x=$((x1 - x0)) \
            'BEGIN { h = int(s/3600); m = int((s%3600)/60)
                     cx = 100 * x / (s * 19200000)
                     printf "%dh %02dm asleep: %.2f W (%.1f Wh)|", h, m, w, c/1e6*v/1e6
                     if (w > 0) printf "A full battery would last %.0f days asleep at this rate. ", f/1e6*v/1e6/w/24
                     if (cx < 90) printf "Deep sleep only %.0f%% of the time (cxsd)!", cx
                     else printf "Deep sleep %.0f%% of the time.", cx }')
        notify "${msg%%|*}" "${msg#*|}"
    fi
    [ -e "$csv" ] || echo "start,minutes,mah,watts,status,aosd_ticks,cxsd_ticks,ddr_ticks,kernel,boot,radios,cxsd_entries,apss_entries,cxsd_last_entered_ticks" > "$csv"
    # the radios column came on 23 October: extend an older header once
    head -1 "$csv" | grep -q ',radios' || sed -i '1s/$/,radios/' "$csv"
    # CX/APSS entry counts came on 14 November
    head -1 "$csv" | grep -q ',cxsd_entries' || sed -i '1s/$/,cxsd_entries,apss_entries,cxsd_last_entered_ticks/' "$csv"
    echo "$(date -d @"$t0" +%FT%T),$((secs / 60)),$(((c0 - c1) / 1000)),$w,$s0/$s1/$s2,$((a1 - a0)),$((x1 - x0)),$((d1 - d0)),$(uname -r),$(boot),$rad,$((xc1 - xc0)),$((ac1 - ac0)),$xl1" >> "$csv"
    ;;
esac
exit 0
