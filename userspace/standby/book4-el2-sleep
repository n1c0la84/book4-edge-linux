#!/bin/sh
# Book4 (book4-edge package; first written by install/el2/sleep-setup.sh): prepare s2idle deep sleep at EL2.
set -eu
modprobe el1tmr
# memlat (sleep-backport 0029-0036): DDR/LLCC follow the CPUs' memory needs.
# The SCMI vendor protocol does not autoload; optional, never fatal.
modprobe -q qcom_generic_ext 2>/dev/null && modprobe -q scmi_qcom_memlat_devfreq 2>/dev/null || true
modprobe icc_hold nodes=/soc@0/ufshc@1d84000 tag=3
# Without a verified hold, releasing the boot votes breaks UFS on resume.
dmesg | grep -q 'icc_hold: holding [1-9][0-9]* paths (tag 3)' ||
    { echo "icc_hold holds no UFS path; boot votes NOT released" >&2; exit 1; }
# Release the boot votes after audio has taken its own (ADSP attached, card up).
i=0
while [ $i -lt 90 ] && [ ! -e /proc/asound/card0 ]; do sleep 1; i=$((i + 1)); done
[ -e /proc/asound/card0 ] || echo "no sound card after 90 s; releasing the boot votes anyway" >&2
# No AOSD: the SoC hard-resets in it about hourly (sleep-setup.sh header).
# It needs the AOSS QMP driver, which can still be probing (-EPROBE_DEFER,
# 20 Oct): retry, and never let it stop the rest.
if [ "${BOOK4_AOSD:-0}" != 1 ]; then
    i=0
    until modprobe aoss_cxsd_only 2>/dev/null || [ $i -ge 30 ]; do sleep 1; i=$((i + 1)); done
    [ -d /sys/module/aoss_cxsd_only ] || echo "aoss_cxsd_only did not load: AOSD stays allowed (hourly resets)" >&2
fi
# No remoteproc recovery: qebspil started the DSPs and Linux only attaches
# (qcom,broken-reset), so after a DSP crash recovery calls a start op that
# does not exist and oopses in rproc_start (pc 0x0; 25 October, CDSP crash
# after a hung NPU session). A crashed DSP then stays offline until reboot.
for r in /sys/class/remoteproc/remoteproc*; do
    printf disabled > "$r/recovery" 2>/dev/null || true
done
n=0
for p in $(find /sys/devices -name state_synced); do
    [ "$(cat "$p")" = 1 ] || { printf 1 > "$p"; n=$((n + 1)); }
done
echo "el1tmr loaded, AOSD $([ -d /sys/module/aoss_cxsd_only ] && echo off || echo allowed), UFS held, sync_state forced on $n provider(s)"
