#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# systemd-sleep hook (test): Windows' firmware drives TLMM GPIO 44 (MODS) low
# at Modern Standby "display off" and high at "display on". Do the same around
# suspend. Only acts when GPIO 44 is usable (the gpio44 test DTB is booted).
CHIP=$(for c in /sys/bus/gpio/devices/gpiochip*; do
         [ -e "$c" ] && readlink -f "$c" | grep -q f100000.pinctrl && basename "$c"; done | head -1)
[ -n "$CHIP" ] || exit 0
gpioinfo -c "$CHIP" 44 >/dev/null 2>&1 || exit 0
case "$1/$2" in
    pre/*)  v=0; when=pre;;
    post/*) v=1; when=post;;
    *) exit 0;;
esac
# gpioset holds the line until killed; exit status 124 (timeout) means it was set
timeout 1 gpioset -c "$CHIP" 44=$v 2>/dev/null; rc=$?
if [ $rc = 124 ]; then
    logger -t book4-mods "GPIO 44 = $v ($when $2)"
else
    logger -t book4-mods "GPIO 44 not settable (reserved in this DTB?), rc=$rc"
fi
case x in
esac
exit 0
