From b8bcc9ff0405098c8da147d1fd1b253997338341 Mon Sep 17 00:00:00 2001
From: Nicola Nicodemo <nicola084@gmail.com>
Date: Fri, 2 Oct 2026 18:51:48 +0200
Subject: [PATCH 2/2] arm64: dts: qcom: x1e80100-samsung-galaxy-book4-edge-14:
 enable the front camera

The 14" model has an OmniVision OV02C10 on CCI0 bus 0 at 0x36 (Windows:
qccamfrontsensor_extension8380, SCFG_FRONT_QRD.bin, partron_ov02c10),
two data lanes on CSIPHY0, MCLK4 on gpio100 and reset on gpio109.

GPIOs 96 and 99 are raised before reset is released in the Windows power
sequence (CAMF_RES_QRD.bin) and are hogged high here; 221 and 225 are
hogged as in zensanp's Book4 Edge tree. The privacy LED is on TLMM 110
(as on the Dell XPS 13 9345) and is attached to the sensor as its privacy
LED, so the V4L2 core lights it while streaming.

Tested on a Galaxy Book4 Edge 14" (NP940XMA): the sensor probes, and
libcamera's simple pipeline captures 1920x1092 at about 40 fps through the
software ISP; the LED is on while streaming and off afterwards.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VZvhNtszdDfmc8XTwbYbqN
Signed-off-by: Nicola Nicodemo <nicola084@gmail.com>
---
 .../x1e80100-samsung-galaxy-book4-edge-14.dts | 126 ++++++++++++++++++
 1 file changed, 126 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-samsung-galaxy-book4-edge-14.dts b/arch/arm64/boot/dts/qcom/x1e80100-samsung-galaxy-book4-edge-14.dts
index ba674ab27..fdef187c5 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-samsung-galaxy-book4-edge-14.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-samsung-galaxy-book4-edge-14.dts
@@ -2,12 +2,84 @@
 
 /dts-v1/;
 
+#include <dt-bindings/leds/common.h>
+
 #include "x1e-samsung-galaxy-book4-edge.dtsi"
 
 / {
 	model = "Samsung Galaxy Book4 Edge (14 inch)";
 	compatible = "samsung,galaxy-book4-edge-14", "samsung,galaxy-book4-edge",
 		     "qcom,x1e80100";
+
+	camera-leds {
+		compatible = "gpio-leds";
+
+		pinctrl-0 = <&cam_indicator_en>;
+		pinctrl-names = "default";
+
+		cam_privacy_led: led-camera-indicator {
+			label = "white:camera-indicator";
+			function = LED_FUNCTION_INDICATOR;
+			color = <LED_COLOR_ID_WHITE>;
+			gpios = <&tlmm 110 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+};
+
+&camss {
+	vdd-csiphy-0p8-supply = <&vreg_l2c_0p8>;
+	vdd-csiphy-1p2-supply = <&vreg_l1c_1p2>;
+
+	status = "okay";
+
+	ports {
+		port@0 {
+			csiphy0_ep: endpoint {
+				data-lanes = <0 1>;
+				remote-endpoint = <&ov02c10_ep>;
+			};
+		};
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	clock-frequency = <100000>;
+
+	camera@36 {
+		compatible = "ovti,ov02c10";
+		reg = <0x36>;
+
+		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_rgb_default>;
+		pinctrl-names = "default";
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		avdd-supply = <&vreg_l7b_2p8>;
+		dvdd-supply = <&vreg_l7b_2p8>;
+		dovdd-supply = <&vreg_l10b_1p8>;
+
+		leds = <&cam_privacy_led>;
+		led-names = "privacy";
+
+		orientation = <0>; /* front */
+		rotation = <180>;
+
+		port {
+			ov02c10_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <400000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
 };
 
 &i2c13 {
@@ -26,3 +98,57 @@ touchpad@40 {
 &panel {
 	compatible = "samsung,atna40cu07", "samsung,atna33xc20";
 };
+
+&tlmm {
+	/* Raised before the sensor is reset (Windows CAMF_RES_QRD.bin: 99, then 96) */
+	cam-vdd-en-96-hog {
+		gpio-hog;
+		gpios = <96 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "cam-vdd-en-96";
+	};
+
+	cam-vdd-en-99-hog {
+		gpio-hog;
+		gpios = <99 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "cam-vdd-en-99";
+	};
+
+	cam-shutter-hog {
+		gpio-hog;
+		gpios = <221 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "cam-shutter-enable";
+	};
+
+	cam-enable-hog {
+		gpio-hog;
+		gpios = <225 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "cam-enable";
+	};
+
+	cam_indicator_en: cam-indicator-en-state {
+		pins = "gpio110";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_rgb_default: cam-rgb-default-state {
+		mclk-pins {
+			pins = "gpio100";
+			function = "cam_aon";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		reset-n-pins {
+			pins = "gpio109";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+};
-- 
