&{/} {
 camera-leds {
  compatible = "gpio-leds";
  pinctrl-0 = <&cam_indicator_en>;
  pinctrl-names = "default";
  cam_privacy_led: led-camera-indicator {
   label = "white:camera-indicator";
   function = "indicator";
   color = <0>;
   gpios = <&tlmm 110 0>;
   default-state = "off";
  };
 };
};
&{/soc@0} {
 cci0: cci@ac15000 {
  compatible = "qcom,x1e80100-cci", "qcom,msm8996-cci";
  reg = <0 0x0ac15000 0 0x1000>;
  interrupts = <0 460 1>;
  clocks = <&camcc 5>,
    <&camcc 14>,
    <&camcc 9>;
  clock-names = "camnoc_axi",
         "cpas_ahb",
         "cci";
  power-domains = <&camcc 5>;
  pinctrl-0 = <&cci0_default>;
  pinctrl-1 = <&cci0_sleep>;
  pinctrl-names = "default", "sleep";
  #address-cells = <1>;
  #size-cells = <0>;
  status = "okay";
  cci0_i2c0: i2c-bus@0 {
   reg = <0>;
   clock-frequency = <100000>;
   #address-cells = <1>;
   #size-cells = <0>;
   camera@36 {
    compatible = "ovti,ov02c10";
    reg = <0x36>;
    reset-gpios = <&tlmm 109 1>;
    pinctrl-0 = <&cam_rgb_default>;
    pinctrl-names = "default";
    clocks = <&camcc 79>;
    assigned-clocks = <&camcc 79>;
    assigned-clock-rates = <19200000>;
    avdd-supply = <&vreg_l7b_2p8>;
    dvdd-supply = <&vreg_l7b_2p8>;
    dovdd-supply = <&vreg_l10b_1p8>;
    leds = <&cam_privacy_led>;
    led-names = "privacy";
    orientation = <0>;
    rotation = <180>;
    port {
     ov02c10_ep: endpoint {
      data-lanes = <1 2>;
      link-frequencies = /bits/ 64 <400000000>;
      remote-endpoint = <&csiphy0_ep>;
     };
    };
   };
  };
  cci0_i2c1: i2c-bus@1 {
   reg = <1>;
   clock-frequency = <1000000>;
   #address-cells = <1>;
   #size-cells = <0>;
  };
 };
