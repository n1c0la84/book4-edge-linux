&tlmm {
 cci0_default: cci0-default-state {
  cci0_i2c0_default: cci0-i2c0-default-pins {
   pins = "gpio101", "gpio102";
   function = "cci_i2c";
   drive-strength = <2>;
   bias-pull-up;
  };
  cci0_i2c1_default: cci0-i2c1-default-pins {
   pins = "gpio103", "gpio104";
   function = "cci_i2c";
   drive-strength = <2>;
   bias-pull-up;
  };
 };
 cci0_sleep: cci0-sleep-state {
  cci0_i2c0_sleep: cci0-i2c0-sleep-pins {
   pins = "gpio101", "gpio102";
   function = "cci_i2c";
   drive-strength = <2>;
   bias-pull-down;
  };
  cci0_i2c1_sleep: cci0-i2c1-sleep-pins {
   pins = "gpio103", "gpio104";
   function = "cci_i2c";
   drive-strength = <2>;
   bias-pull-down;
  };
 };
 cam-vdd-en-96-hog {
  gpio-hog;
  gpios = <96 0>;
  output-high;
  line-name = "cam-vdd-en-96";
 };
 cam-vdd-en-99-hog {
  gpio-hog;
  gpios = <99 0>;
  output-high;
  line-name = "cam-vdd-en-99";
 };
 cam-shutter-hog {
  gpio-hog;
  gpios = <221 0>;
  output-high;
  line-name = "cam-shutter-enable";
 };
 cam-enable-hog {
  gpio-hog;
  gpios = <225 0>;
  output-high;
  line-name = "cam-enable";
 };
 cam_indicator_en: cam-indicator-en-state {
  pins = "gpio110";
  function = "gpio";
  drive-strength = <2>;
  bias-disable;
 };
 cam_rgb_default: cam-rgb-default-state {
  mclk-pins {
   pins = "gpio100";
   function = "cam_aon";
   drive-strength = <16>;
   bias-disable;
  };
  reset-n-pins {
   pins = "gpio109";
   function = "gpio";
   drive-strength = <2>;
   bias-disable;
  };
 };
