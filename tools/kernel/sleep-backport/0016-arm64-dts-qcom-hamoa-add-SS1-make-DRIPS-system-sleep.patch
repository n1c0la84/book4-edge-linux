From 9bc9de7e46f8d74819298cedef5d49d2430f9897 Mon Sep 17 00:00:00 2001
From: Nicola Nicodemo <nicola084@gmail.com>
Date: Mon, 19 Oct 2026 16:27:51 +0200
Subject: [PATCH 16/23] arm64: dts: qcom: hamoa: add SS1, make DRIPS
 system-sleep-only

Add platform.SS1 (0x02000154, from ACPI \_SB.SYSM._LPI) for runtime idle and
keep domain_ss3 (DRIPS) for system suspend only.

From github.com/justririll/x1e-sleep (sleep/dts-hamoa-add-ss1-idle-state.patch, commit 4e84b60), not upstream.
Taken for testing on the Galaxy Book4 Edge; see book4-edge-linux docs/power.md.
---
 arch/arm64/boot/dts/qcom/hamoa.dtsi | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/hamoa.dtsi b/arch/arm64/boot/dts/qcom/hamoa.dtsi
index bc3ea92..1ebca35 100644
--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -304,12 +304,23 @@ cluster_cl5: cluster-sleep-1 {
 				min-residency-us = <7000>;
 			};
 
+			/* ACPI \_SB.SYSM _LPI "platform.SS1": 7.5 ms residency, 0.5 ms latency */
+			domain_ss1: domain-sleep-1 {
+				compatible = "domain-idle-state";
+				arm,psci-suspend-param = <0x02000154>;
+				entry-latency-us = <250>;
+				exit-latency-us = <250>;
+				min-residency-us = <7500>;
+			};
+
 			domain_ss3: domain-sleep-0 {
 				compatible = "domain-idle-state";
 				arm,psci-suspend-param = <0x0200c354>;
 				entry-latency-us = <2500>;
 				exit-latency-us = <2500>;
 				min-residency-us = <9000>;
+				/* DRIPS from runtime idle hangs the SoC after the first s2idle */
+				system-sleep-only;
 			};
 		};
 	};
@@ -469,7 +480,7 @@ cluster_pd2: power-domain-cpu-cluster2 {
 
 		system_pd: power-domain-system {
 			#power-domain-cells = <0>;
-			domain-idle-states = <&domain_ss3>;
+			domain-idle-states = <&domain_ss1>, <&domain_ss3>;
 		};
 	};
 
