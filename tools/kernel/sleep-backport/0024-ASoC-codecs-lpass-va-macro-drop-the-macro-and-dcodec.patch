From 901a2fbc311a279850575caa7421b88a304360fd Mon Sep 17 00:00:00 2001
From: Nicola Nicodemo <nicola084@gmail.com>
Date: Mon, 19 Oct 2026 22:21:47 +0200
Subject: [PATCH] ASoC: codecs: lpass-va-macro: drop the macro and dcodec votes
 in runtime suspend

The VA macro enables its "macro" and "dcodec" clocks (on X1E the q6prm
LPASS_HW_MACRO and LPASS_HW_DCODEC votes, which ask the ADSP to keep the
LPASS macro and digital codec hardware powered) at probe and releases them
only in remove(); runtime suspend drops just mclk and npl. The votes stay
in force for as long as the driver is bound, including system suspend.

On the Galaxy Book4 Edge (X1E80100) with the ADSP running, CX never
collapses in s2idle; with the sound card, SoundWire, the WSA macros and
the q6apm DAIs unbound, these two votes are the last LPASS clocks Linux
holds (enable count 1 each, from va_macro).

Release them in runtime suspend and take them again on resume, in the
same order as probe, as the RX and TX macros already do through pm_clk.

Assisted-by: Claude Opus 5.5
---
 sound/soc/codecs/lpass-va-macro.c | 27 ++++++++++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

diff --git a/sound/soc/codecs/lpass-va-macro.c b/sound/soc/codecs/lpass-va-macro.c
index 58a5798..5fa302b 100644
--- a/sound/soc/codecs/lpass-va-macro.c
+++ b/sound/soc/codecs/lpass-va-macro.c
@@ -1724,6 +1724,8 @@ static int va_macro_runtime_suspend(struct device *dev)
 		clk_disable_unprepare(va->npl);
 
 	clk_disable_unprepare(va->mclk);
+	clk_disable_unprepare(va->dcodec);
+	clk_disable_unprepare(va->macro);
 
 	return 0;
 }
@@ -1733,18 +1735,29 @@ static int va_macro_runtime_resume(struct device *dev)
 	struct va_macro *va = dev_get_drvdata(dev);
 	int ret;
 
+	ret = clk_prepare_enable(va->macro);
+	if (ret) {
+		dev_err(va->dev, "unable to prepare macro\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(va->dcodec);
+	if (ret) {
+		dev_err(va->dev, "unable to prepare dcodec\n");
+		goto err_dcodec;
+	}
+
 	ret = clk_prepare_enable(va->mclk);
 	if (ret) {
 		dev_err(va->dev, "unable to prepare mclk\n");
-		return ret;
+		goto err_mclk;
 	}
 
 	if (va->has_npl_clk) {
 		ret = clk_prepare_enable(va->npl);
 		if (ret) {
-			clk_disable_unprepare(va->mclk);
 			dev_err(va->dev, "unable to prepare npl\n");
-			return ret;
+			goto err_npl;
 		}
 	}
 
@@ -1752,6 +1765,14 @@ static int va_macro_runtime_resume(struct device *dev)
 	regcache_sync(va->regmap);
 
 	return 0;
+
+err_npl:
+	clk_disable_unprepare(va->mclk);
+err_mclk:
+	clk_disable_unprepare(va->dcodec);
+err_dcodec:
+	clk_disable_unprepare(va->macro);
+	return ret;
 }
 
 
