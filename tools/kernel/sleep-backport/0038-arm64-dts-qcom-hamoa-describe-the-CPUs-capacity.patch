+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -73,6 +73,7 @@ cpu0: cpu@0 {
 			compatible = "qcom,oryon";
 			reg = <0x0 0x0>;
 			enable-method = "psci";
