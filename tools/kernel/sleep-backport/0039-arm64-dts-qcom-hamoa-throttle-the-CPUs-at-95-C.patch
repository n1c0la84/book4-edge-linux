 		};
 
 		cpu0-0-top-thermal {
+			polling-delay-passive = <200>;
+
 			thermal-sensors = <&tsens0 1>;
 
+			cooling-maps {
+				map0 {
+					trip = <&cpu0_0_top_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+
 			trips {
+				cpu0_0_top_alert0: trip-point0 {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
