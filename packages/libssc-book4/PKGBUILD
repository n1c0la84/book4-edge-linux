# SPDX-License-Identifier: GPL-2.0-only
# libssc 0.4.4 (Arch's recipe) plus Rafael Meneses' patch from
# github.com/rafaelmnz/SB4-Edge-Linux (GPL-2.0, patches/libssc): the light
# sensor is looked up by the data type in LIBSSC_LIGHT_DATA_TYPE (default
# "ambient_light"). The Galaxy Book4 Edge's VEML3328 is published as "color",
# so stock libssc never finds it. Replaces Arch's libssc (only
# iio-sensor-proxy uses it). docs/sensors.md.
#
#   cd packages/libssc-book4 && makepkg -f
pkgname=libssc-book4
pkgver=0.4.4
pkgrel=1
pkgdesc='Library for Qualcomm Sensor Core sensors, with a light-sensor data type override (Galaxy Book4 Edge)'
arch=(aarch64)
url='https://libssc.dylanvanassche.be/'
license=(GPL-3.0-or-later)
depends=(glib2 glibc libgcc libqmi libqrtr-glib protobuf-c)
makedepends=(git gobject-introspection meson protobuf)
provides=("libssc=$pkgver")
conflicts=(libssc)
source=("libssc::git+https://codeberg.org/DylanVanAssche/libssc#tag=v$pkgver"
        0001-light-data-type-override-and-value-debug.patch)
sha256sums=('28d9063308f0ab480d2cb79bcfff9e5fc02f5e271f9774e9448ae86911ea5c7e'
            'dee504f9bbb4e56ff168e4bae11aea77ad3bf8071da72967a62a678a5414dd1d')

prepare() {
  cd libssc
  git checkout -q -- . && git clean -q -fd
  git apply "$srcdir/0001-light-data-type-override-and-value-debug.patch"
}

build() {
  meson setup build libssc --prefix=/usr --libexecdir=lib --buildtype=plain
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
