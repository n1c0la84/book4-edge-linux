diff --git a/src/libssc-sensor-light.c b/src/libssc-sensor-light.c
index e0bd99a..8403027 100644
--- a/src/libssc-sensor-light.c
+++ b/src/libssc-sensor-light.c
@@ -57,6 +57,15 @@ emit_signal (gpointer user_data) {
 	return G_SOURCE_REMOVE;
 }
 
+/* The data type to look the light sensor up by: "ambient_light" unless LIBSSC_LIGHT_DATA_TYPE says otherwise (some
+ * devices only expose an RGB colour sensor, data type "rgb"). */
+static const gchar *
+light_data_type (void)
+{
+	const gchar *t = g_getenv ("LIBSSC_LIGHT_DATA_TYPE");
+	return (t && *t) ? t : "ambient_light";
+}
+
 static void
