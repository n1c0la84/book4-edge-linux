 			return;
 		}
 
+		for (gsize i = 0; i < msg->n_intensity; i++)
+			g_debug ("light value[%" G_GSIZE_FORMAT "] = %f (accuracy %d)", i, msg->intensity[i], msg->accuracy);
+
 		/* Only report intensity in Lux, raw sensor values are ignored */
 		if (msg->n_intensity >= 1) {
 			intensity = msg->intensity[0];
@@ -274,7 +286,7 @@ ssc_sensor_light_new (GCancellable *cancellable, GAsyncReadyCallback callback, g
 			cancellable,
