# SPDX-License-Identifier: GPL-2.0-only (this file; the firmware is not)
# book4-edge-firmware: the firmware this Galaxy Book4 Edge 14" needs beyond
# linux-firmware, built LOCALLY and NEVER PUBLISHED (the DSP and GPU files
# are Samsung/Qualcomm's, from this laptop's own Windows partition). Nothing
# proprietary is in this repository: install/arch/firmware-stage.sh copies
# the files into a private staging directory, picked and checked by
# sha256sums.txt, and this package takes them from there.
#
#   bash install/arch/firmware-stage.sh            (Windows partition read-only)
#   cd packages/book4-edge-firmware && makepkg -f
#   sudo pacman -U --overwrite '/usr/lib/firmware/updates/*' book4-edge-firmware-*.pkg.tar.*
#
# tcblaunch.exe (build 10.0.26100.9616, the tested one; Windows Update has
# moved System32 on to 9882) goes to /usr/lib/book4/; book4-el2
# (book4-edge-el2) copies it and the ADSP/CDSP images to the ESP.
# The ambient light sensor's Qualcomm Sensor Core config (qcsensorsconfigcrd8380:
# JSON, sns_reg_config, socinfo) and the registry Windows generated from it
# go to /usr/share/book4/sensors/ (docs/sensors.md; book4-sensors-setup).
pkgname=book4-edge-firmware
pkgver=2026.11.23
pkgrel=1
pkgdesc='Galaxy Book4 Edge 14": ADSP/CDSP/GPU firmware and tcblaunch.exe from its own Windows, Wi-Fi c5-00302, audio topology alias, ambient light sensor config and registry (local only)'
arch=(any)
license=(LicenseRef-proprietary)
depends=(linux-firmware-qcom)
options=(!strip !debug)

_stage=${BOOK4_FW_STAGE:-$HOME/.local/share/book4-edge-firmware}

package() {
  local sums=$startdir/sha256sums.txt fw=$pkgdir/usr/lib/firmware/updates sum path src
  while read -r sum path src; do
    case "$sum" in ''|\#*) continue ;; esac
    [ -e "$_stage/$path" ] || { echo "missing $_stage/$path (run install/arch/firmware-stage.sh)" >&2; return 1; }
    [ "$(sha256sum < "$_stage/$path" | cut -d' ' -f1)" = "$sum" ] || { echo "checksum mismatch: $path" >&2; return 1; }
    case "$path" in
      /*) install -Dm644 "$_stage/$path" "$pkgdir$path" ;;   # e.g. /usr/lib/book4/tcblaunch.exe
      *)  install -Dm644 "$_stage/$path" "$fw/$path" ;;
    esac
  done < "$sums"
  # The card's topology is the CRD's (docs/audio.md): an alias, no copy.
  install -d "$fw/qcom/x1e80100"
  ln -s ../../../qcom/x1e80100/X1E80100-CRD-tplg.bin "$fw/qcom/x1e80100/X1E80100-GalaxyBook4Edge-tplg.bin"
}
