From 14fd8b3184ef187d515030157df685055be4bec1 Mon Sep 17 00:00:00 2001
From: justririll <cate1233211@gmail.com>
Date: Sat, 3 Oct 2026 17:13:20 +0300
Subject: [PATCH] pil: send AOSS load_state off/on before starting ADSP/CDSP

Add a minimal polled AOSS QMP client (apps channel, MSGRAM0) and send
"{class: image, res: load_state, name: adsp|cdsp, val: off}" followed by
"val: on" right before auth_and_reset, like a Linux PAS stop + start
(qcom_q6v5_prepare()) of a DSP started by firmware.

Without it AOSS does not know the DSP image is running; after the first
DDR low-power mode in s2idle the ADSP stops answering (GLINK TX hangs,
battmgr -110) and the system dies a few seconds after resume. The QMP
mailbox is polled because this runs from the late ExitBootServices
callback without interrupts.

Tested on ASUS Vivobook S15 (X1E80100) at EL2 with slbounce: ADSP and
CDSP survive s2idle with CXSD/AOSD reached.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Makefile        |   1 +
 src/pil-types.c |   2 +
 src/pil.c       |   7 ++
 src/qebspil.h   |   3 +
 src/qmp.c       | 178 ++++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 191 insertions(+)
 create mode 100644 src/qmp.c

diff --git a/Makefile b/Makefile
index 4977828..186c0cd 100644
--- a/Makefile
+++ b/Makefile
@@ -41,6 +41,7 @@ QEBSPIL_OBJS := \
 	src/pil.o \
 	src/pil-types.o \
 	src/scm.o \
+	src/qmp.o \
 	src/external/cache.o \
 	src/external/libc.o \
 	src/external/lkfdt.o \
diff --git a/src/pil-types.c b/src/pil-types.c
index 0333075..c18faf4 100644
--- a/src/pil-types.c
+++ b/src/pil-types.c
@@ -43,12 +43,14 @@ static const struct pil_type pil_types[] = {
 			.lite = 41,
 		},
 		.proxy_guid = PIL_PROXY_ADSP_DTB_GUID,
+		.load_state = "adsp",
 	},
 	{
 		.compatible = "qcom,x1e80100-cdsp-pas",
 		.id[PIL_MAIN].full = 18,
 		.id[PIL_DTB].full = 37,
 		.proxy_guid = PIL_PROXY_CDSP_DTB_GUID,
+		.load_state = "cdsp",
 	},
 };
 
diff --git a/src/pil.c b/src/pil.c
index 1a7d7d4..083cce3 100644
--- a/src/pil.c
+++ b/src/pil.c
@@ -164,6 +164,13 @@ static EFI_STATUS pil_finish(struct pil *pil)
 		scm_pil_stop(pil->type->id[b - 1].lite);
 	}
 
+	/* Like Linux qcom_q6v5_prepare(): tell AOSS the image is going to run */
+	if (pil->type->load_state) {
+		/* off then on, like a Linux PAS stop + start of a firmware-started DSP */
+		qmp_send_load_state(pil->type->load_state, FALSE);
+		qmp_send_load_state(pil->type->load_state, TRUE);
+	}
+
 	for (enum pil_component c = 0; c < PIL_COMPONENTS; c++) {
 		if (!pil_has_component(pil, c))
 			continue;
diff --git a/src/qebspil.h b/src/qebspil.h
index 17265d6..fd4f422 100644
--- a/src/qebspil.h
+++ b/src/qebspil.h
@@ -21,6 +21,7 @@ struct pil_type {
 	const char *compatible;
 	struct pil_id id[PIL_COMPONENTS];
 	EFI_GUID proxy_guid;
+	const char *load_state;
 };
 
 struct pil_fw {
@@ -69,4 +70,6 @@ EFI_STATUS scm_pil_mem_setup(UINT8 pas_id, EFI_PHYSICAL_ADDRESS addr, UINTN size
 EFI_STATUS scm_pil_start(UINT8 pas_id);
 EFI_STATUS scm_pil_stop(UINT8 pas_id);
 
+EFI_STATUS qmp_send_load_state(const char *name, BOOLEAN on);
+
 #endif
diff --git a/src/qmp.c b/src/qmp.c
new file mode 100644
index 0000000..7405eff
--- /dev/null
+++ b/src/qmp.c
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal polled AOSS QMP client (apps channel, MSGRAM0) for qebspil.
+ *
+ * Mirrors drivers/soc/qcom/qcom_aoss.c qmp_open()/qmp_send(), but polls
+ * the message RAM instead of waiting for the AOSS interrupt, so it can run
+ * from the late ExitBootServices callback. Used to send
+ * "{class: image, res: load_state, name: <rproc>, val: on}" right before
+ * auth_and_reset, like Linux qcom_q6v5_prepare() does.
+ */
+
+#include <efi.h>
+#include <efilib.h>
+
+#include "qebspil.h"
+
+#define QMP_MSGRAM		0x0c300000UL
+#define IPCC_BASE		0x00408000UL
+#define IPCC_REG_SEND_ID	0x0c
+#define IPCC_CLIENT_AOP		0
+#define IPCC_SIGNAL_QMP		0
+
+#define QMP_DESC_MAGIC			0x0
+#define QMP_DESC_VERSION		0x4
+#define QMP_DESC_UCORE_LINK_STATE	0xc
+#define QMP_DESC_UCORE_LINK_STATE_ACK	0x10
+#define QMP_DESC_UCORE_CH_STATE		0x14
+#define QMP_DESC_UCORE_CH_STATE_ACK	0x18
+#define QMP_DESC_MCORE_LINK_STATE	0x24
+#define QMP_DESC_MCORE_LINK_STATE_ACK	0x28
+#define QMP_DESC_MCORE_CH_STATE		0x2c
+#define QMP_DESC_MCORE_CH_STATE_ACK	0x30
+#define QMP_DESC_MCORE_MBOX_SIZE	0x34
+#define QMP_DESC_MCORE_MBOX_OFFSET	0x38
+
+#define QMP_STATE_UP		0x0000ffff
+#define QMP_MAGIC		0x4d41494c
+#define QMP_VERSION		1
+#define QMP_MSG_LEN		64
+
+static inline UINT32 rd(UINTN off)
+{
+	return *(volatile UINT32 *)(QMP_MSGRAM + off);
+}
+
+static inline void wr(UINTN off, UINT32 val)
+{
+	*(volatile UINT32 *)(QMP_MSGRAM + off) = val;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void qmp_kick(void)
+{
+	*(volatile UINT32 *)(IPCC_BASE + IPCC_REG_SEND_ID) =
+		(IPCC_CLIENT_AOP << 16) | IPCC_SIGNAL_QMP;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static UINT64 ticks(void)
+{
+	UINT64 v;
+
+	__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(v));
+	return v;
+}
+
+static UINT64 tick_freq(void)
+{
+	UINT64 v;
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(v));
+	return v ? v : 19200000;
+}
+
+/* Wait up to ~1 s for rd(off) == val (or != 0 -> 0 when want_zero) */
+static BOOLEAN wait_eq(UINTN off, UINT32 val)
+{
+	UINT64 end = ticks() + tick_freq();
+
+	while (ticks() < end)
+		if (rd(off) == val)
+			return TRUE;
+	return FALSE;
+}
+
+static UINT32 mbox_off;
+static BOOLEAN qmp_ready;
+
+static EFI_STATUS qmp_open(void)
+{
+	if (qmp_ready)
+		return EFI_SUCCESS;
+
+	if (rd(QMP_DESC_MAGIC) != QMP_MAGIC || rd(QMP_DESC_VERSION) != QMP_VERSION) {
+		Print(u"qebspil: QMP: bad magic/version 0x%x/0x%x\n",
+		      rd(QMP_DESC_MAGIC), rd(QMP_DESC_VERSION));
+		return EFI_DEVICE_ERROR;
+	}
+
+	mbox_off = rd(QMP_DESC_MCORE_MBOX_OFFSET);
+	if (!rd(QMP_DESC_MCORE_MBOX_SIZE))
+		return EFI_DEVICE_ERROR;
+
+	/* Channel left open by an earlier user (firmware): just reuse it */
+	if (rd(QMP_DESC_MCORE_LINK_STATE_ACK) == QMP_STATE_UP &&
+	    rd(QMP_DESC_MCORE_CH_STATE_ACK) == QMP_STATE_UP &&
+	    rd(QMP_DESC_UCORE_CH_STATE) == QMP_STATE_UP) {
+		qmp_ready = TRUE;
+		return EFI_SUCCESS;
+	}
+
+	wr(QMP_DESC_UCORE_LINK_STATE_ACK, rd(QMP_DESC_UCORE_LINK_STATE));
+	wr(QMP_DESC_MCORE_LINK_STATE, QMP_STATE_UP);
+	qmp_kick();
+	if (!wait_eq(QMP_DESC_MCORE_LINK_STATE_ACK, QMP_STATE_UP)) {
+		Print(u"qebspil: QMP: link not acked\n");
+		return EFI_TIMEOUT;
+	}
+
+	wr(QMP_DESC_MCORE_CH_STATE, QMP_STATE_UP);
+	qmp_kick();
+	if (!wait_eq(QMP_DESC_UCORE_CH_STATE, QMP_STATE_UP)) {
+		Print(u"qebspil: QMP: channel not opened\n");
+		return EFI_TIMEOUT;
+	}
+
+	wr(QMP_DESC_UCORE_CH_STATE_ACK, QMP_STATE_UP);
+	qmp_kick();
+	if (!wait_eq(QMP_DESC_MCORE_CH_STATE_ACK, QMP_STATE_UP)) {
+		Print(u"qebspil: QMP: channel not acked\n");
+		return EFI_TIMEOUT;
+	}
+
+	qmp_ready = TRUE;
+	return EFI_SUCCESS;
+}
+
+EFI_STATUS qmp_send_load_state(const char *name, BOOLEAN on)
+{
+	char buf[QMP_MSG_LEN];
+	const char *pre = "{class: image, res: load_state, name: ";
+	const char *post = on ? ", val: on}" : ", val: off}";
+	UINTN n = 0, i;
+	EFI_STATUS status;
+
+	status = qmp_open();
+	if (EFI_ERROR(status))
+		return status;
+
+	for (i = 0; i < sizeof(buf); i++)
+		buf[i] = 0;
+	for (i = 0; pre[i] && n < sizeof(buf) - 1; i++)
+		buf[n++] = pre[i];
+	for (i = 0; name[i] && n < sizeof(buf) - 1; i++)
+		buf[n++] = name[i];
+	for (i = 0; post[i] && n < sizeof(buf) - 1; i++)
+		buf[n++] = post[i];
+
+	/* The message RAM only implements 32-bit accesses */
+	for (i = 0; i < sizeof(buf) / 4; i++) {
+		UINT32 w = (UINT8)buf[i * 4] | ((UINT8)buf[i * 4 + 1] << 8) |
+			   ((UINT8)buf[i * 4 + 2] << 16) | ((UINT32)(UINT8)buf[i * 4 + 3] << 24);
+		wr(mbox_off + 4 + i * 4, w);
+	}
+	wr(mbox_off, sizeof(buf));
+	(void)rd(mbox_off);
+	qmp_kick();
+
+	if (!wait_eq(mbox_off, 0)) {
+		Print(u"qebspil: QMP: load_state %a %a not acked\n", name, on ? "on" : "off");
+		/* Clear the message so Linux starts with an empty mailbox */
+		wr(mbox_off, 0);
+		return EFI_TIMEOUT;
+	}
+
+	Print(u"qebspil: QMP: load_state %a %a\n", name, on ? "on" : "off");
+	return EFI_SUCCESS;
+}
-- 
